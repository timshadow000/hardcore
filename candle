local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local TOOL_NAME = "Candle"
local TOOL_TIP = "A blue candle... click to light it!"
local TOOL_ICON = "rbxassetid://242911609"

local MESH_BODY = "rbxassetid://4186570325"
local MESH_PLATE = "rbxassetid://431033844"
local MESH_PLATE2 = "rbxassetid://2885450026"

local PLATE_TEXTURE = "rbxassetid://100214094"
local FLAME_TEXTURE = "rbxassetid://160041569"

local SOUND_IGNITE = "rbxassetid://7278182233"
local SOUND_CRACKLE = "rbxassetid://516449725"
local SOUND_BLOWOUT = "rbxassetid://1509941164"

local FLAME_COLOR = Color3.fromRGB(0, 38, 255)

local function makeSound(parent, name, id, looped)
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Looped = looped
	sound.Volume = 1
	sound.Parent = parent
	return sound
end

local function makeMeshPart(name, meshId, textureId, size, color, material, scale)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Massless = true

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = meshId
	if textureId then
		mesh.TextureId = textureId
	end
	mesh.Scale = scale
	mesh.Parent = part

	return part
end

local function buildCandle()
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = TOOL_TIP
	tool.TextureId = TOOL_ICON
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.Grip = CFrame.new()

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = tool

	local function weldToHandle(part)
		local weld = Instance.new("Weld")
		weld.Name = part.Name .. "_Weld"
		weld.Part0 = handle
		weld.Part1 = part
		weld.C0 = handle.CFrame:ToObjectSpace(part.CFrame)
		weld.C1 = CFrame.new()
		weld.Parent = handle
	end

	local body = makeMeshPart("Body", MESH_BODY, nil,
		Vector3.new(0.4, 1.54, 0.4),
		Color3.fromRGB(248, 236, 213),
		Enum.Material.Sand,
		Vector3.new(2.27, 3.009, 2.217)
	)
	body.CFrame = CFrame.new(0, 0.85, 0) * CFrame.Angles(0, math.rad(90), 0)
	body.Parent = tool
	weldToHandle(body)

	local bodyLight = Instance.new("PointLight")
	bodyLight.Name = "BodyLight"
	bodyLight.Color = FLAME_COLOR
	bodyLight.Brightness = 1
	bodyLight.Range = 4
	bodyLight.Enabled = false
	bodyLight.Parent = body

	local plate = makeMeshPart("Plate", MESH_PLATE, PLATE_TEXTURE,
		Vector3.new(0.64, 1.09, 0.64),
		Color3.fromRGB(126, 81, 9),
		Enum.Material.Glass,
		Vector3.new(0.00314, 0.00342, 0.00314)
	)
	plate.CFrame = CFrame.new(0, 0.35, 0)
	plate.Parent = tool
	weldToHandle(plate)

	local plate2 = makeMeshPart("Plate2", MESH_PLATE2, PLATE_TEXTURE,
		Vector3.new(0.91, 0.31, 0.81),
		Color3.fromRGB(126, 81, 9),
		Enum.Material.Glass,
		Vector3.new(0.0183, 0.0527, 0.0161)
	)
	plate2.CFrame = CFrame.new(0, -0.03, 0) * CFrame.Angles(0, math.rad(180), 0)
	plate2.Parent = tool
	weldToHandle(plate2)

	local flame = Instance.new("Part")
	flame.Name = "Flame"
	flame.Size = Vector3.new(0.11, 0.11, 0.11)
	flame.Transparency = 1
	flame.CanCollide = false
	flame.CanTouch = false
	flame.CanQuery = false
	flame.CastShadow = false
	flame.Massless = true
	flame.CFrame = CFrame.new(0, 1.61, 0)
	flame.Parent = tool
	weldToHandle(flame)

	local light = Instance.new("PointLight")
	light.Name = "FlameLight"
	light.Color = Color3.fromRGB(0, 13, 255)
	light.Brightness = 10
	light.Range = 5
	light.Shadows = true
	light.Enabled = false
	light.Parent = flame

	local fire = Instance.new("ParticleEmitter")
	fire.Name = "Fire"
	fire.Texture = FLAME_TEXTURE
	fire.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, FLAME_COLOR),
		ColorSequenceKeypoint.new(0.49, Color3.fromRGB(0, 110, 255)),
		ColorSequenceKeypoint.new(1, FLAME_COLOR)
	})
	fire.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.5, 0.13),
		NumberSequenceKeypoint.new(1, 0)
	})
	fire.Transparency = NumberSequence.new(0)
	fire.Lifetime = NumberRange.new(0.1, 0.15)
	fire.Rate = 50
	fire.Speed = NumberRange.new(2, 4)
	fire.SpreadAngle = Vector2.new(10, 10)
	fire.LightEmission = 0.3
	fire.RotSpeed = NumberRange.new(-10, 10)
	fire.Orientation = Enum.ParticleOrientation.FacingCamera
	fire.Shape = Enum.ParticleEmitterShape.Box
	fire.Enabled = false
	fire.Parent = flame

	makeSound(flame, "IgniteSound", SOUND_IGNITE, false)
	makeSound(flame, "CrackleSound", SOUND_CRACKLE, true)
	makeSound(flame, "BlowOutSound", SOUND_BLOWOUT, false)

	local click = Instance.new("ClickDetector")
	click.Name = "ClickDetector"
	click.MaxActivationDistance = 15
	click.Parent = handle

	return tool
end

local function setupCandle(tool)
	local flame = tool:FindFirstChild("Flame")
	if not flame then return end

	local fire = flame:FindFirstChildOfClass("ParticleEmitter")
	local light = flame:FindFirstChild("FlameLight")
	local body = tool:FindFirstChild("Body")
	local bodyLight = body and body:FindFirstChild("BodyLight")
	local ignite = flame:FindFirstChild("IgniteSound")
	local crackle = flame:FindFirstChild("CrackleSound")
	local blowOut = flame:FindFirstChild("BlowOutSound")
	local handle = tool:FindFirstChild("Handle")
	local click = handle and handle:FindFirstChildOfClass("ClickDetector")

	local lit = false
	local busy = false
	local flickering = false

	local function startFlicker()
		if flickering then return end
		flickering = true
		task.spawn(function()
			while lit and light and light.Parent do
				light.Brightness = 8 + math.random() * 4
				light.Range = 4.5 + math.random()
				task.wait(0.08)
			end
			flickering = false
		end)
	end

	local function lightUp()
		lit = true
		if fire then fire.Enabled = true end
		if light then
			light.Enabled = true
			light.Brightness = 10
			light.Range = 5
		end
		if bodyLight then bodyLight.Enabled = true end
		if ignite then ignite:Play() end
		if crackle then crackle:Play() end
		startFlicker()
	end

	local function putOut()
		lit = false
		if fire then fire.Enabled = false end
		if light then light.Enabled = false end
		if bodyLight then bodyLight.Enabled = false end
		if crackle then crackle:Stop() end
		if blowOut then blowOut:Play() end
	end

	local function toggle()
		if busy then return end
		busy = true
		if lit then putOut() else lightUp() end
		task.wait(0.25)
		busy = false
	end

	tool.Activated:Connect(toggle)
	if click then
		click.MouseClick:Connect(toggle)
	end
end

local activeTool = nil
local isEquipped = false

local function giveCandle()
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then return end

	local oldBackpack = backpack:FindFirstChild(TOOL_NAME)
	if oldBackpack then oldBackpack:Destroy() end

	if player.Character then
		local oldCharacter = player.Character:FindFirstChild(TOOL_NAME)
		if oldCharacter then oldCharacter:Destroy() end
	end

	local candle = buildCandle()
	setupCandle(candle)
	candle.Parent = backpack
end

local function onCharacterAdded(character)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	task.wait(0.5)
	giveCandle()
end

player.CharacterAdded:Connect(onCharacterAdded)

if player.Character then
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	task.defer(giveCandle)
end

local function monitorTool(tool)
	if tool.Name ~= TOOL_NAME then return end
	
	tool.Equipped:Connect(function()
		isEquipped = true
		activeTool = tool
		
		task.wait()
		local character = player.Character
		if character then
			local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
			if rightHand then
				local grip = rightHand:FindFirstChild("RightGrip")
				if grip then
					grip:Destroy()
				end
			end
		end
	end)
	
	tool.Unequipped:Connect(function()
		isEquipped = false
		activeTool = nil
	end)
end

local function setupCharacter(character)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			monitorTool(child)
		end
	end)
end

if player.Character then
	setupCharacter(player.Character)
end
player.CharacterAdded:Connect(setupCharacter)

RunService.RenderStepped:Connect(function()
	if isEquipped and activeTool and activeTool.Parent == player.Character then
		local handle = activeTool:FindFirstChild("Handle")
		if handle then

			local offset = CFrame.new(1.2, -1.8, -3.0) * CFrame.Angles(math.rad(-10), math.rad(15), math.rad(-5))
	
			local bob = math.sin(tick() * 8) * 0.03
			
			handle.CFrame = camera.CFrame * offset * CFrame.new(0, bob, 0)
		end
	end
end)
